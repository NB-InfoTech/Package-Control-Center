# ============================================================
# Package Control Center (PCC) — Git ignore rules
# ============================================================

# --- Dependencies -------------------------------------------------
node_modules/

# --- Build output -------------------------------------------------
dist/
release/
out/
*.tsbuildinfo

# --- Logs & diagnostics -------------------------------------------
# Runtime logs are written to ~/.package-control-center/logs and must
# never be committed — they contain local machine paths.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local environment / secrets -----------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.json
credentials.json

# --- OS / editor cruft ---------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~

# --- Local PCC data (never commit user data) -----------------------
# PCC persists to ~/.package-control-center and
# ~/Documents/Package Control Center Backups — if a developer ever
# points a build at a repo-local path, keep it out of git.
.package-control-center/
*.installed-packages-*.json
restore-report-*.json
migration-complete.flag

# --- Local scratch / audit artifacts -------------------------------
# Generated by tools/ scripts and scripts/verify-*.cjs at runtime.
tools/audit-err.txt
tools/audit-out.json
tools/winget-*.txt
window-proof-*.log

# --- Installer scratch ---------------------------------------------
*.exe
*.msi
*.blockmap
latest.yml